{
  "name": "joyboy",
  "private": true,
  "version": "1.0.0",
  "description": "Joyboy – Lern-Spiele für Kinder",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rules": "node scripts/make-rules.mjs",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only database --project demo-joyboy \"node scripts/test-rules.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/grandstander": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
